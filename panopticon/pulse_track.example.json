{
  "rules": [
    {
      "rule_id": "known-person-any",
      "name": "Personne connue reconnue",
      "condition": {
        "trigger": "known_person",
        "camera_ids": [],
        "person_names": []
      },
      "enabled": true,
      "cooldown_s": 120.0,
      "severity": "info",
      "message_template": "{rule_name} : personne reconnue sur {camera_id}"
    },
    {
      "rule_id": "unknown-person-night",
      "name": "Inconnu détecté la nuit",
      "condition": {
        "trigger": "unknown_person",
        "camera_ids": ["ENTREE"],
        "hours_start": "22:00",
        "hours_end": "06:00"
      },
      "enabled": true,
      "cooldown_s": 60.0,
      "severity": "warning",
      "message_template": "{rule_name} sur {camera_id}"
    },
    {
      "rule_id": "vehicle-detected",
      "name": "Véhicule détecté",
      "condition": {
        "trigger": "object_class",
        "camera_ids": [],
        "object_classes": ["car", "truck", "motorcycle"],
        "min_confidence": 0.5
      },
      "enabled": true,
      "cooldown_s": 30.0,
      "severity": "info",
      "message_template": "{rule_name} sur {camera_id}"
    },
    {
      "rule_id": "person-lingering",
      "name": "Présence prolongée",
      "condition": {
        "trigger": "track_dwell",
        "camera_ids": [],
        "object_classes": ["person"],
        "dwell_seconds": 30.0,
        "min_confidence": 0.4
      },
      "enabled": false,
      "cooldown_s": 300.0,
      "severity": "warning",
      "message_template": "{rule_name} sur {camera_id} (>=30s)"
    }
  ],
  "argus": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "roster": {
    "host": "127.0.0.1",
    "port": 8766
  },
  "publisher": {
    "host": "127.0.0.1",
    "port": 8769
  },
  "log_stats_every_s": 10.0
}